// Every raylib function keeps its C name, in the namespace rl:
// rl::InitWindow(800, 450, "Goose"), rl::DrawText("hi", 10, 10, 20, rl::RED).
// Hand-written helpers are in rl_extras.goose, raymath in raymath.goose.

namespace rl;

