fn LoadShader(vsFileName: const u8[:], fsFileName: const u8[:]) -> Shader {
    let vsFileName_z = cstring(vsFileName);
    let fsFileName_z = cstring(fsFileName);
    if vsFileName.len == 0 && fsFileName.len == 0 { return c_LoadShader_null_vsFileName_fsFileName(0, 0); }
    if vsFileName.len != 0 && fsFileName.len == 0 { return c_LoadShader_null_fsFileName(vsFileName_z[0], 0); }
    if vsFileName.len == 0 && fsFileName.len != 0 { return c_LoadShader_null_vsFileName(0, fsFileName_z[0]); }
    return c_LoadShader(vsFileName_z[0], fsFileName_z[0]);
}

fn LoadShaderFromMemory(vsCode: const u8[:], fsCode: const u8[:]) -> Shader {
    let vsCode_z = cstring(vsCode);
    let fsCode_z = cstring(fsCode);
    if vsCode.len == 0 && fsCode.len == 0 { return c_LoadShaderFromMemory_null_vsCode_fsCode(0, 0); }
    if vsCode.len != 0 && fsCode.len == 0 { return c_LoadShaderFromMemory_null_fsCode(vsCode_z[0], 0); }
    if vsCode.len == 0 && fsCode.len != 0 { return c_LoadShaderFromMemory_null_vsCode(0, fsCode_z[0]); }
    return c_LoadShaderFromMemory(vsCode_z[0], fsCode_z[0]);
}

