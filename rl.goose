    if codepoints.len == 0 { return c_LoadFontEx_null_codepoints(fileName_z[0], fontSize, 0, 0); }
    return c_LoadFontEx(fileName_z[0], fontSize, codepoints[0], codepoints.len as i32);
}

fn LoadFontFromMemory(fileType: const u8[:], fileData: const u8[:], fontSize: i32, codepoints: const i32[:]) -> Font {
    let fileType_z = cstring(fileType);
    if fileData.len == 0 && codepoints.len == 0 { return c_LoadFontFromMemory_null_fileData_codepoints(fileType_z[0], 0, 0, fontSize, 0, 0); }
    if fileData.len != 0 && codepoints.len == 0 { return c_LoadFontFromMemory_null_codepoints(fileType_z[0], fileData[0], fileData.len as i32, fontSize, 0, 0); }
    if fileData.len == 0 && codepoints.len != 0 { return c_LoadFontFromMemory_null_fileData(fileType_z[0], 0, 0, fontSize, codepoints[0], codepoints.len as i32); }
    return c_LoadFontFromMemory(fileType_z[0], fileData[0], fileData.len as i32, fontSize, codepoints[0], codepoints.len as i32);
}

fn LoadFontData(fileData: const u8[:], fontSize: i32, codepoints: const i32[:], type_: i32, glyphCount: i32&) -> u64 {
    if fileData.len == 0 && codepoints.len == 0 { return c_LoadFontData_null_fileData_codepoints(0, 0, fontSize, 0, 0, type_, glyphCount); }
    if fileData.len != 0 && codepoints.len == 0 { return c_LoadFontData_null_codepoints(fileData[0], fileData.len as i32, fontSize, 0, 0, type_, glyphCount); }
    if fileData.len == 0 && codepoints.len != 0 { return c_LoadFontData_null_fileData(0, 0, fontSize, codepoints[0], codepoints.len as i32, type_, glyphCount); }
    return c_LoadFontData(fileData[0], fileData.len as i32, fontSize, codepoints[0], codepoints.len as i32, type_, glyphCount);
}

