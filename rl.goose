// CameraMode: Camera system modes
let CAMERA_CUSTOM       = 0; // Camera custom, controlled by user (UpdateCamera() does nothing)
let CAMERA_FREE         = 1; // Camera free mode
let CAMERA_ORBITAL      = 2; // Camera orbital, around target, zoom supported
let CAMERA_FIRST_PERSON = 3; // Camera first person
let CAMERA_THIRD_PERSON = 4; // Camera third person

// CameraProjection: Camera projection
let CAMERA_PERSPECTIVE  = 0; // Perspective projection
let CAMERA_ORTHOGRAPHIC = 1; // Orthographic projection

// NPatchLayout: N-patch layout
let NPATCH_NINE_PATCH             = 0; // Npatch layout: 3x3 tiles
let NPATCH_THREE_PATCH_VERTICAL   = 1; // Npatch layout: 1x3 tiles
let NPATCH_THREE_PATCH_HORIZONTAL = 2; // Npatch layout: 3x1 tiles

// Older names, kept by raylib.h.
let MOUSE_LEFT_BUTTON = MOUSE_BUTTON_LEFT;
let MOUSE_RIGHT_BUTTON = MOUSE_BUTTON_RIGHT;
let MOUSE_MIDDLE_BUTTON = MOUSE_BUTTON_MIDDLE;
let MATERIAL_MAP_DIFFUSE = MATERIAL_MAP_ALBEDO;
let MATERIAL_MAP_SPECULAR = MATERIAL_MAP_METALNESS;
let SHADER_LOC_MAP_DIFFUSE = SHADER_LOC_MAP_ALBEDO;
let SHADER_LOC_MAP_SPECULAR = SHADER_LOC_MAP_METALNESS;

// --- structs ----------------------------------------------------------------
//
// Laid out as C lays them out; `_padN` fields stand for C's padding.
// Pointers the library owns (Image.data, Font.glyphs, ...) are u64.

// Vector2, 2 components (8 bytes)
struct Vector2 {
    x: f32, // Vector x component
    y: f32  // Vector y component
}

// Vector3, 3 components (12 bytes)
struct Vector3 {
    x: f32, // Vector x component
    y: f32, // Vector y component
    z: f32  // Vector z component
}

// Vector4, 4 components (16 bytes)
struct Vector4 {
    x: f32, // Vector x component
    y: f32, // Vector y component
    z: f32, // Vector z component
    w: f32  // Vector w component
}

// Matrix, 4x4 components, column major, OpenGL style, right-handed (64 bytes)
struct Matrix {
    m0: f32,  // Matrix first row (4 components)
    m4: f32,  // Matrix first row (4 components)
    m8: f32,  // Matrix first row (4 components)
    m12: f32, // Matrix first row (4 components)
    m1: f32,  // Matrix second row (4 components)
    m5: f32,  // Matrix second row (4 components)
    m9: f32,  // Matrix second row (4 components)
    m13: f32, // Matrix second row (4 components)
    m2: f32,  // Matrix third row (4 components)
    m6: f32,  // Matrix third row (4 components)
    m10: f32, // Matrix third row (4 components)
    m14: f32, // Matrix third row (4 components)
    m3: f32,  // Matrix fourth row (4 components)
    m7: f32,  // Matrix fourth row (4 components)
    m11: f32, // Matrix fourth row (4 components)
    m15: f32  // Matrix fourth row (4 components)
}

// Color, 4 components, R8G8B8A8 (32bit) (4 bytes)
struct Color {
    r: u8, // Color red value
    g: u8, // Color green value
    b: u8, // Color blue value
    a: u8  // Color alpha value
}

// Rectangle, 4 components (16 bytes)
struct Rectangle {
    x: f32,      // Rectangle top-left corner position x
    y: f32,      // Rectangle top-left corner position y
    width: f32,  // Rectangle width
    height: f32  // Rectangle height
}

// Image, pixel data stored in CPU memory (RAM) (24 bytes)
struct Image {
    data: u64,    // Image raw data
    width: i32,   // Image base width
    height: i32,  // Image base height
    mipmaps: i32, // Mipmap levels, 1 by default
    format: i32   // Data format (PixelFormat type)
}

// Texture, tex data stored in GPU memory (VRAM) (20 bytes)
struct Texture {
    id: u32,      // OpenGL texture id
    width: i32,   // Texture base width
    height: i32,  // Texture base height
    mipmaps: i32, // Mipmap levels, 1 by default
    format: i32   // Data format (PixelFormat type)
}

// RenderTexture, fbo for texture rendering (44 bytes)
struct RenderTexture {
    id: u32,          // OpenGL framebuffer object id
    texture: Texture, // Color buffer attachment texture
    depth: Texture    // Depth buffer attachment texture
}

// NPatchInfo, n-patch layout info (36 bytes)
struct NPatchInfo {
    source: Rectangle, // Texture source rectangle
    left: i32,         // Left border offset
    top: i32,          // Top border offset
    right: i32,        // Right border offset
    bottom: i32,       // Bottom border offset
    layout: i32        // Layout of the n-patch: 3x3, 1x3 or 3x1
}

// GlyphInfo, font characters glyphs info (40 bytes)
struct GlyphInfo {
    value: i32,    // Character value (Unicode)
    offsetX: i32,  // Character offset X when drawing
    offsetY: i32,  // Character offset Y when drawing
    advanceX: i32, // Character advance position X
    image: Image   // Character image data
}

// Font, font texture and GlyphInfo array data (48 bytes)
struct Font {
    baseSize: i32,      // Base size (default chars height)
    glyphCount: i32,    // Number of glyph characters
    glyphPadding: i32,  // Padding around the glyph characters
    texture: Texture2D, // Texture atlas containing the glyphs
    recs: u64,          // Rectangles in texture for the glyphs
    glyphs: u64         // Glyphs info data
}

// Camera, defines position/orientation in 3d space (44 bytes)
struct Camera3D {
    position: Vector3, // Camera position
    target: Vector3,   // Camera target it looks-at
    up: Vector3,       // Camera up vector (rotation over its axis)
    fovy: f32,         // Camera field-of-view aperture in Y (degrees) in perspective, used as near plane height in world units in orthographic
    projection: i32    // Camera projection: CAMERA_PERSPECTIVE or CAMERA_ORTHOGRAPHIC
}

// Camera2D, defines position/orientation in 2d space (24 bytes)
struct Camera2D {
    offset: Vector2, // Camera offset (screen space offset from window origin, unscaled by DPI, real pixel size)
    target: Vector2, // Camera target (world space target point that is mapped to screen space offset)
    rotation: f32,   // Camera rotation in degrees (pivots around target)
    zoom: f32        // Camera zoom (scaling around target), must not be set to 0, set to 1.0f for no scale
}

// Mesh, vertex data and vao/vbo (120 bytes)
struct Mesh {
    vertexCount: i32,   // Number of vertices stored in arrays
    triangleCount: i32, // Number of triangles stored (indexed or not)
    vertices: u64,      // Vertex position (XYZ - 3 components per vertex) (shader-location = 0)
    texcoords: u64,     // Vertex texture coordinates (UV - 2 components per vertex) (shader-location = 1)
    texcoords2: u64,    // Vertex texture second coordinates (UV - 2 components per vertex) (shader-location = 5)
    normals: u64,       // Vertex normals (XYZ - 3 components per vertex) (shader-location = 2)
    tangents: u64,      // Vertex tangents (XYZW - 4 components per vertex) (shader-location = 4)
    colors: u64,        // Vertex colors (RGBA - 4 components per vertex) (shader-location = 3)
    indices: u64,       // Vertex indices (in case vertex data comes indexed)
    boneCount: i32,     // Number of bones (MAX: 256 bones)
    _pad0: u8[4] = [0, 0, 0, 0],
    boneIndices: u64,   // Vertex bone indices, up to 4 bones influence by vertex (skinning) (shader-location = 6)
    boneWeights: u64,   // Vertex bone weight, up to 4 bones influence by vertex (skinning) (shader-location = 7)
    animVertices: u64,  // Animated vertex positions (after bones transformations)
    animNormals: u64,   // Animated normals (after bones transformations)
    vaoId: u32,         // OpenGL Vertex Array Object id
    _pad1: u8[4] = [0, 0, 0, 0],
    vboId: u64          // OpenGL Vertex Buffer Objects id (default vertex data)
}

// Shader (16 bytes)
struct Shader {
    id: u32,      // Shader program id
    _pad0: u8[4] = [0, 0, 0, 0],
    locs: u64     // Shader locations array (RL_MAX_SHADER_LOCATIONS)
}

// MaterialMap (28 bytes)
struct MaterialMap {
    texture: Texture2D, // Material map texture
    color: Color,       // Material map color
    value: f32          // Material map value
}

// Material, includes shader and maps (40 bytes)
struct Material {
    shader: Shader, // Material shader
    maps: u64,      // Material maps array (MAX_MATERIAL_MAPS)
    params: f32[4]  // Material generic parameters (if required)
}

// Transform, vertex transformation data (40 bytes)
struct Transform {
    translation: Vector3, // Translation
    rotation: Quaternion, // Rotation
    scale: Vector3        // Scale
}

// Bone, skeletal animation bone (36 bytes)
struct BoneInfo {
    name: u8[32], // Bone name
    parent: i32   // Bone parent
}

// Skeleton, animation bones hierarchy (24 bytes)
struct ModelSkeleton {
    boneCount: u32, // Number of bones
    _pad0: u8[4] = [0, 0, 0, 0],
    bones: u64,     // Bones information (skeleton)
    bindPose: u64   // Bones base transformation (Transform[])
}

// Model, meshes, materials and animation data (136 bytes)
struct Model {
    transform: Matrix,       // Local transform matrix
    meshCount: i32,          // Number of meshes
    materialCount: i32,      // Number of materials
    meshes: u64,             // Meshes array
    materials: u64,          // Materials array
    meshMaterial: u64,       // Mesh material number
    skeleton: ModelSkeleton, // Skeleton for animation
    currentPose: u64,        // Current animation pose (Transform[])
    boneMatrices: u64        // Bones animated transformation matrices
}

// ModelAnimation, contains a full animation sequence (48 bytes)
struct ModelAnimation {
    name: u8[32],       // Animation name
    boneCount: u32,     // Number of bones (per pose)
    keyframeCount: i32, // Number of animation key frames
    keyframePoses: u64  // Animation sequence keyframe poses [keyframe][pose]
}

// Ray, ray for raycasting (24 bytes)
struct Ray {
    position: Vector3,  // Ray position (origin)
    direction: Vector3  // Ray direction (normalized)
}

// RayCollision, ray hit information (32 bytes)
struct RayCollision {
    hit: bool,       // Did the ray hit something?
    _pad0: u8[3] = [0, 0, 0],
    distance: f32,   // Distance to the nearest hit
    point: Vector3,  // Point of the nearest hit
    normal: Vector3  // Surface normal of hit
}

// BoundingBox (24 bytes)
struct BoundingBox {
    min: Vector3, // Minimum vertex box-corner
    max: Vector3  // Maximum vertex box-corner
}

// Wave, audio wave data (24 bytes)
struct Wave {
    frameCount: u32, // Total number of frames (considering channels)
    sampleRate: u32, // Frequency (samples per second)
    sampleSize: u32, // Bit depth (bits per sample): 8, 16, 32 (24 not supported)
    channels: u32,   // Number of channels (1-mono, 2-stereo, ...)
    data: u64        // Buffer data pointer
}

// AudioStream, custom audio stream (32 bytes)
struct AudioStream {
    buffer: u64,     // Pointer to internal data used by the audio system
    processor: u64,  // Pointer to internal data processor, useful for audio effects
    sampleRate: u32, // Frequency (samples per second)
    sampleSize: u32, // Bit depth (bits per sample): 8, 16, 32 (24 not supported)
    channels: u32,   // Number of channels (1-mono, 2-stereo, ...)
    _pad0: u8[4] = [0, 0, 0, 0] // C's tail padding
}

// Sound (40 bytes)
struct Sound {
    stream: AudioStream, // Audio stream
    frameCount: u32,     // Total number of frames (considering channels)
    _pad0: u8[4] = [0, 0, 0, 0] // C's tail padding
}

// Music, audio stream, anything longer than ~10 seconds should be streamed (56 bytes)
struct Music {
    stream: AudioStream, // Audio stream
    frameCount: u32,     // Total number of frames (considering channels)
    looping: bool,       // Music looping enable
    _pad0: u8[3] = [0, 0, 0],
    ctxType: i32,        // Type of music context (audio filetype)
    _pad1: u8[4] = [0, 0, 0, 0],
    ctxData: u64         // Audio context data, depends on type
}

// VrDeviceInfo, Head-Mounted-Display device parameters (60 bytes)
struct VrDeviceInfo {
    hResolution: i32,             // Horizontal resolution in pixels
    vResolution: i32,             // Vertical resolution in pixels
    hScreenSize: f32,             // Horizontal size in meters
    vScreenSize: f32,             // Vertical size in meters
    eyeToScreenDistance: f32,     // Distance between eye and display in meters
    lensSeparationDistance: f32,  // Lens separation distance in meters
    interpupillaryDistance: f32,  // IPD (distance between pupils) in meters
    lensDistortionValues: f32[4], // Lens distortion constant parameters
    chromaAbCorrection: f32[4]    // Chromatic aberration correction parameters
}

// VrStereoConfig, VR stereo rendering configuration for simulator (304 bytes)
struct VrStereoConfig {
    projection: Matrix[2],     // VR projection matrices (per eye)
    viewOffset: Matrix[2],     // VR view offset matrices (per eye)
    leftLensCenter: f32[2],    // VR left lens center
    rightLensCenter: f32[2],   // VR right lens center
    leftScreenCenter: f32[2],  // VR left screen center
    rightScreenCenter: f32[2], // VR right screen center
    scale: f32[2],             // VR distortion scale
    scaleIn: f32[2]            // VR distortion scale in
}

// File path list (16 bytes)
struct FilePathList {
    count: u32,   // Filepaths entries count
    _pad0: u8[4] = [0, 0, 0, 0],
    paths: u64    // Filepaths entries
}

// Automation event (24 bytes)
struct AutomationEvent {
    frame: u32,     // Event frame
    type_: u32,     // Event type (AutomationEventType)
    params: i32[4]  // Event parameters (if required)
}

// Automation event list (16 bytes)
struct AutomationEventList {
    capacity: u32, // Events max entries (MAX_AUTOMATION_EVENTS)
    count: u32,    // Events entries count
    events: u64    // Events entries
}

type Quaternion = Vector4; // Quaternion, 4 components (Vector4 alias)
type Texture2D = Texture; // Texture2D, same as Texture
type TextureCubemap = Texture; // TextureCubemap, same as Texture
type RenderTexture2D = RenderTexture; // RenderTexture2D, same as RenderTexture
type Camera = Camera3D; // Camera type fallback, defaults to Camera3D
type ModelAnimPose = u64; // Anim pose, an array of Transform[] (Transform *)

// --- functions --------------------------------------------------------------
//
// Bound from the raylib shared library when the program starts. A
// function that takes C strings or (pointer, count) arrays is bound as
// c_Name and wrapped by Name below, which takes Goose slices.

extern "raylib" {
    fn c_InitWindow(width: i32, height: i32, title: const u8&) = "InitWindow"; // Initialize window and OpenGL context
    fn CloseWindow(); // Close window and unload OpenGL context
    fn WindowShouldClose() -> bool; // Check if application should close (KEY_ESCAPE pressed or windows close icon clicked)
    fn IsWindowReady() -> bool; // Check if window has been initialized successfully
    fn IsWindowFullscreen() -> bool; // Check if window is currently fullscreen
    fn IsWindowHidden() -> bool; // Check if window is currently hidden
    fn IsWindowMinimized() -> bool; // Check if window is currently minimized
    fn IsWindowMaximized() -> bool; // Check if window is currently maximized
    fn IsWindowFocused() -> bool; // Check if window is currently focused
    fn IsWindowResized() -> bool; // Check if window has been resized last frame
    fn IsWindowState(flag: u32) -> bool; // Check if one specific window flag is enabled
    fn SetWindowState(flags: u32); // Set window configuration state using flags
    fn ClearWindowState(flags: u32); // Clear window configuration state flags
    fn ToggleFullscreen(); // Toggle window state: fullscreen/windowed, resizes monitor to match window resolution
    fn ToggleBorderlessWindowed(); // Toggle window state: borderless windowed, resizes window to match monitor resolution
    fn MaximizeWindow(); // Set window state: maximized, if resizable
    fn MinimizeWindow(); // Set window state: minimized, if resizable
    fn RestoreWindow(); // Restore window from being minimized/maximized
    fn SetWindowIcon(image: Image); // Set icon for window (single image, RGBA 32bit)
    fn SetWindowIcons(images: Image&, count: i32); // Set icon for window (multiple images, RGBA 32bit)
    fn c_SetWindowTitle(title: const u8&) = "SetWindowTitle"; // Set title for window
    fn SetWindowPosition(x: i32, y: i32); // Set window position on screen
    fn SetWindowMonitor(monitor: i32); // Set monitor for the current window
    fn SetWindowMinSize(width: i32, height: i32); // Set window minimum dimensions (for FLAG_WINDOW_RESIZABLE)
    fn SetWindowMaxSize(width: i32, height: i32); // Set window maximum dimensions (for FLAG_WINDOW_RESIZABLE)
    fn SetWindowSize(width: i32, height: i32); // Set window dimensions
    fn SetWindowOpacity(opacity: f32); // Set window opacity [0.0f..1.0f]
    fn SetWindowFocused(); // Set window focused
    fn GetWindowHandle() -> u64; // Get native window handle
    fn GetScreenWidth() -> i32; // Get current screen width
    fn GetScreenHeight() -> i32; // Get current screen height
    fn GetRenderWidth() -> i32; // Get current render width (it considers HiDPI)
    fn GetRenderHeight() -> i32; // Get current render height (it considers HiDPI)
    fn GetMonitorCount() -> i32; // Get number of connected monitors
    fn GetCurrentMonitor() -> i32; // Get current monitor where window is placed
    fn GetMonitorPosition(monitor: i32) -> Vector2; // Get specified monitor position
    fn GetMonitorWidth(monitor: i32) -> i32; // Get specified monitor width (current video mode used by monitor)
    fn GetMonitorHeight(monitor: i32) -> i32; // Get specified monitor height (current video mode used by monitor)
    fn GetMonitorPhysicalWidth(monitor: i32) -> i32; // Get specified monitor physical width in millimetres
    fn GetMonitorPhysicalHeight(monitor: i32) -> i32; // Get specified monitor physical height in millimetres
    fn GetMonitorRefreshRate(monitor: i32) -> i32; // Get specified monitor refresh rate
    fn GetWindowPosition() -> Vector2; // Get window position XY on monitor
    fn GetWindowScaleDPI() -> Vector2; // Get window scale DPI factor
    fn c_GetMonitorName(monitor: i32) -> u64 = "GetMonitorName"; // Get the human-readable, UTF-8 encoded name of the specified monitor
    fn c_SetClipboardText(text: const u8&) = "SetClipboardText"; // Set clipboard text content
    fn c_GetClipboardText() -> u64 = "GetClipboardText"; // Get clipboard text content
    fn GetClipboardImage() -> Image; // Get clipboard image content
    fn EnableEventWaiting(); // Enable waiting for events on EndDrawing(), no automatic event polling
    fn DisableEventWaiting(); // Disable waiting for events on EndDrawing(), automatic events polling
    fn ShowCursor(); // Show cursor
    fn HideCursor(); // Hide cursor
    fn IsCursorHidden() -> bool; // Check if cursor is not visible
    fn EnableCursor(); // Enable cursor (unlock cursor)
    fn DisableCursor(); // Disable cursor (lock cursor)
    fn IsCursorOnScreen() -> bool; // Check if cursor is on the screen
    fn ClearBackground(color: Color); // Clear background (framebuffer) to color
    fn BeginDrawing(); // Begin canvas (framebuffer) drawing
    fn EndDrawing(); // End canvas (framebuffer) drawing and swap buffers (double buffering)
    fn BeginMode2D(camera: Camera2D); // Begin 2D mode with custom camera (2D)
    fn EndMode2D(); // End 2D mode with custom camera
    fn BeginMode3D(camera: Camera3D); // Begin 3D mode with custom camera (3D)
    fn EndMode3D(); // End 3D mode and returns to default 2D orthographic mode
    fn BeginTextureMode(target: RenderTexture2D); // Begin drawing to render texture
    fn EndTextureMode(); // End drawing to render texture
    fn BeginShaderMode(shader: Shader); // Begin custom shader drawing
    fn EndShaderMode(); // End custom shader drawing (use default shader)
    fn BeginBlendMode(mode: i32); // Begin blending mode (alpha, additive, multiplied, subtract, custom)
    fn EndBlendMode(); // End blending mode (reset to default: alpha blending)
    fn BeginScissorMode(x: i32, y: i32, width: i32, height: i32); // Begin scissor mode (define screen area for following drawing)
    fn EndScissorMode(); // End scissor mode
    fn BeginVrStereoMode(config: VrStereoConfig); // Begin stereo rendering (requires VR simulator)
    fn EndVrStereoMode(); // End stereo rendering (requires VR simulator)
    fn LoadVrStereoConfig(device: VrDeviceInfo) -> VrStereoConfig; // Load VR stereo config for VR simulator device parameters
    fn UnloadVrStereoConfig(config: VrStereoConfig); // Unload VR stereo config
    fn c_LoadShader(vsFileName: const u8&, fsFileName: const u8&) -> Shader = "LoadShader"; // Load shader from files and bind default locations
    fn c_LoadShader_null_vsFileName(vsFileName: u64, fsFileName: const u8&) -> Shader = "LoadShader";
    fn c_LoadShader_null_fsFileName(vsFileName: const u8&, fsFileName: u64) -> Shader = "LoadShader";
    fn c_LoadShader_null_vsFileName_fsFileName(vsFileName: u64, fsFileName: u64) -> Shader = "LoadShader";
    fn c_LoadShaderFromMemory(vsCode: const u8&, fsCode: const u8&) -> Shader = "LoadShaderFromMemory"; // Load shader from code strings and bind default locations
    fn c_LoadShaderFromMemory_null_vsCode(vsCode: u64, fsCode: const u8&) -> Shader = "LoadShaderFromMemory";
    fn c_LoadShaderFromMemory_null_fsCode(vsCode: const u8&, fsCode: u64) -> Shader = "LoadShaderFromMemory";
    fn c_LoadShaderFromMemory_null_vsCode_fsCode(vsCode: u64, fsCode: u64) -> Shader = "LoadShaderFromMemory";
    fn IsShaderValid(shader: Shader) -> bool; // Check if shader is valid (loaded on GPU)
    fn c_GetShaderLocation(shader: Shader, uniformName: const u8&) -> i32 = "GetShaderLocation"; // Get shader uniform location
    fn c_GetShaderLocationAttrib(shader: Shader, attribName: const u8&) -> i32 = "GetShaderLocationAttrib"; // Get shader attribute location
    fn SetShaderValue(shader: Shader, locIndex: i32, value: u64, uniformType: i32); // Set shader uniform value
    fn SetShaderValueV(shader: Shader, locIndex: i32, value: u64, uniformType: i32, count: i32); // Set shader uniform value vector
    fn SetShaderValueMatrix(shader: Shader, locIndex: i32, mat: Matrix); // Set shader uniform value (matrix 4x4)
    fn SetShaderValueTexture(shader: Shader, locIndex: i32, texture: Texture2D); // Set shader uniform value and bind the texture (sampler2d)
    fn UnloadShader(shader: Shader); // Unload shader from GPU memory (VRAM)
    fn GetScreenToWorldRay(position: Vector2, camera: Camera) -> Ray; // Get a ray trace from screen position (i.e mouse)
    fn GetScreenToWorldRayEx(position: Vector2, camera: Camera, width: i32, height: i32) -> Ray; // Get a ray trace from screen position (i.e mouse) in a viewport
    fn GetWorldToScreen(position: Vector3, camera: Camera) -> Vector2; // Get screen space position for a 3d world space position
    fn GetWorldToScreenEx(position: Vector3, camera: Camera, width: i32, height: i32) -> Vector2; // Get sized screen space position for a 3d world space position
    fn GetWorldToScreen2D(position: Vector2, camera: Camera2D) -> Vector2; // Get screen space position for a 2d camera world space position
    fn GetScreenToWorld2D(position: Vector2, camera: Camera2D) -> Vector2; // Get world space position for a 2d camera screen space position
    fn GetCameraMatrix(camera: Camera) -> Matrix; // Get camera transform matrix (view matrix)
    fn GetCameraMatrix2D(camera: Camera2D) -> Matrix; // Get camera 2d transform matrix
    fn SetTargetFPS(fps: i32); // Set target FPS (maximum)
    fn GetFrameTime() -> f32; // Get time in seconds for last frame drawn (delta time)
    fn GetTime() -> f64; // Get elapsed time in seconds since InitWindow()
    fn GetFPS() -> i32; // Get current FPS
    fn SwapScreenBuffer(); // Swap back buffer with front buffer (screen drawing)
    fn PollInputEvents(); // Register all input events
    fn WaitTime(seconds: f64); // Wait for some time (halt program execution)
    fn SetRandomSeed(seed: u32); // Set the seed for the random number generator
    fn GetRandomValue(min: i32, max: i32) -> i32; // Get a random value between min and max (both included)
    fn LoadRandomSequence(count: u32, min: i32, max: i32) -> u64; // Load random values sequence, no values repeated
    fn UnloadRandomSequence(sequence: u64); // Unload random values sequence
    fn c_TakeScreenshot(fileName: const u8&) = "TakeScreenshot"; // Takes a screenshot of current screen (filename extension defines format)
    fn SetConfigFlags(flags: u32); // Set init configuration flags (view FLAGS)
    fn c_OpenURL(url: const u8&) = "OpenURL"; // Open URL with default system browser (if available)
    fn SetTraceLogLevel(logLevel: i32); // Set the current threshold (minimum) log level
    fn MemAlloc(size: u32) -> u64; // Internal memory allocator
    fn MemRealloc(ptr: u64, size: u32) -> u64; // Internal memory reallocator
    fn MemFree(ptr: u64); // Internal memory free
    fn c_LoadFileData(fileName: const u8&, dataSize: i32&) -> u64 = "LoadFileData"; // Load file data as byte array (read)
    fn UnloadFileData(data: u64); // Unload file data allocated by LoadFileData()
    fn c_SaveFileData(fileName: const u8&, data: u64, dataSize: i32) -> bool = "SaveFileData"; // Save data to file from byte array (write), returns true on success
    fn c_ExportDataAsCode(data: const u8&, dataSize: i32, fileName: const u8&) -> bool = "ExportDataAsCode"; // Export data to code (.h), returns true on success
    fn c_ExportDataAsCode_null_data(data: u64, dataSize: i32, fileName: const u8&) -> bool = "ExportDataAsCode";
    fn c_LoadFileText(fileName: const u8&) -> u64 = "LoadFileText"; // Load text data from file (read), returns a '\0' terminated string
    fn UnloadFileText(text: u64); // Unload file text data allocated by LoadFileText()
    fn c_SaveFileText(fileName: const u8&, text: const u8&) -> bool = "SaveFileText"; // Save text data to file (write), string must be '\0' terminated, returns true on success
    fn c_FileRename(fileName: const u8&, fileRename: const u8&) -> i32 = "FileRename"; // Rename file (if exists), returns 0 on success
    fn c_FileRemove(fileName: const u8&) -> i32 = "FileRemove"; // Remove file (if exists), returns 0 on success
