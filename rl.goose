    fn DrawSphereEx(centerPos: Vector3, radius: f32, rings: i32, slices: i32, color: Color); // Draw sphere with defined rings and slices
    fn DrawSphereWires(centerPos: Vector3, radius: f32, rings: i32, slices: i32, color: Color); // Draw sphere wires
    fn DrawCylinder(position: Vector3, radiusTop: f32, radiusBottom: f32, height: f32, sides: i32, color: Color); // Draw a cylinder/cone
    fn DrawCylinderEx(startPos: Vector3, endPos: Vector3, startRadius: f32, endRadius: f32, sides: i32, color: Color); // Draw a cylinder with base at startPos and top at endPos
    fn DrawCylinderWires(position: Vector3, radiusTop: f32, radiusBottom: f32, height: f32, sides: i32, color: Color); // Draw a cylinder/cone wires
    fn DrawCylinderWiresEx(startPos: Vector3, endPos: Vector3, startRadius: f32, endRadius: f32, sides: i32, color: Color); // Draw a cylinder wires with base at startPos and top at endPos
    fn DrawCapsule(startPos: Vector3, endPos: Vector3, radius: f32, rings: i32, slices: i32, color: Color); // Draw a capsule with the center of its sphere caps at startPos and endPos
    fn DrawCapsuleWires(startPos: Vector3, endPos: Vector3, radius: f32, rings: i32, slices: i32, color: Color); // Draw capsule wireframe with the center of its sphere caps at startPos and endPos
    fn DrawPlane(centerPos: Vector3, size: Vector2, color: Color); // Draw a plane XZ
    fn DrawRay(ray: Ray, color: Color); // Draw a ray line
    fn DrawGrid(slices: i32, spacing: f32); // Draw a grid (centered at (0, 0, 0))
    fn c_LoadModel(fileName: const u8&) -> Model = "LoadModel"; // Load model from files (meshes and materials)
    fn LoadModelFromMesh(mesh: Mesh) -> Model; // Load model from generated mesh (default material)
    fn IsModelValid(model: Model) -> bool; // Check if model is valid (loaded in GPU, VAO/VBOs)
    fn UnloadModel(model: Model); // Unload model (including meshes) from memory (RAM and/or VRAM)
    fn GetModelBoundingBox(model: Model) -> BoundingBox; // Compute model bounding box limits (considers all meshes)
    fn DrawModel(model: Model, position: Vector3, scale: f32, tint: Color); // Draw a model (with texture if set)
    fn DrawModelEx(model: Model, position: Vector3, rotationAxis: Vector3, rotationAngle: f32, scale: Vector3, tint: Color); // Draw a model with custom transform
    fn DrawModelWires(model: Model, position: Vector3, scale: f32, tint: Color); // Draw a model wires (with texture if set)
    fn DrawModelWiresEx(model: Model, position: Vector3, rotationAxis: Vector3, rotationAngle: f32, scale: Vector3, tint: Color); // Draw a model wires with custom transform
    fn DrawBoundingBox(box: BoundingBox, color: Color); // Draw bounding box (wires)
    fn DrawBillboard(camera: Camera, texture: Texture2D, position: Vector3, scale: f32, tint: Color); // Draw a billboard texture
    fn DrawBillboardRec(camera: Camera, texture: Texture2D, rec: Rectangle, position: Vector3, size: Vector2, tint: Color); // Draw a billboard texture defined by rectangle
    fn DrawBillboardPro(camera: Camera, texture: Texture2D, rec: Rectangle, position: Vector3, up: Vector3, size: Vector2, origin: Vector2, rotation: f32, tint: Color); // Draw a billboard texture defined by source rectangle with scaling and rotation
    fn UploadMesh(mesh: Mesh&, dynamic: bool); // Upload mesh vertex data in GPU and provide VAO/VBO ids
    fn UpdateMeshBuffer(mesh: Mesh, index: i32, data: u64, dataSize: i32, offset: i32); // Update mesh vertex data in GPU for a specific buffer index
    fn UnloadMesh(mesh: Mesh); // Unload mesh data from CPU and GPU
    fn DrawMesh(mesh: Mesh, material: Material, transform: Matrix); // Draw a 3d mesh with material and transform
    fn c_DrawMeshInstanced(mesh: Mesh, material: Material, transforms: const Matrix&, instances: i32) = "DrawMeshInstanced"; // Draw multiple mesh instances with material and different transforms
    fn c_DrawMeshInstanced_null_transforms(mesh: Mesh, material: Material, transforms: u64, instances: i32) = "DrawMeshInstanced";
    fn GetMeshBoundingBox(mesh: Mesh) -> BoundingBox; // Compute mesh bounding box limits
    fn GenMeshTangents(mesh: Mesh&); // Compute mesh tangents
    fn c_ExportMesh(mesh: Mesh, fileName: const u8&) -> bool = "ExportMesh"; // Export mesh data to file, returns true on success
    fn c_ExportMeshAsCode(mesh: Mesh, fileName: const u8&) -> bool = "ExportMeshAsCode"; // Export mesh as code file (.h) defining multiple arrays of vertex attributes
    fn GenMeshPoly(sides: i32, radius: f32) -> Mesh; // Generate polygonal mesh
    fn GenMeshPlane(width: f32, length: f32, resX: i32, resZ: i32) -> Mesh; // Generate plane mesh (with subdivisions)
    fn GenMeshCube(width: f32, height: f32, length: f32) -> Mesh; // Generate cuboid mesh
    fn GenMeshSphere(radius: f32, rings: i32, slices: i32) -> Mesh; // Generate sphere mesh (standard sphere)
    fn GenMeshHemiSphere(radius: f32, rings: i32, slices: i32) -> Mesh; // Generate half-sphere mesh (no bottom cap)
    fn GenMeshCylinder(radius: f32, height: f32, slices: i32) -> Mesh; // Generate cylinder mesh
    fn GenMeshCone(radius: f32, height: f32, slices: i32) -> Mesh; // Generate cone/pyramid mesh
    fn GenMeshTorus(radius: f32, size: f32, radSeg: i32, sides: i32) -> Mesh; // Generate torus mesh
    fn GenMeshKnot(radius: f32, size: f32, radSeg: i32, sides: i32) -> Mesh; // Generate trefoil knot mesh
    fn GenMeshHeightmap(heightmap: Image, size: Vector3) -> Mesh; // Generate heightmap mesh from image data
    fn GenMeshCubicmap(cubicmap: Image, cubeSize: Vector3) -> Mesh; // Generate cubes-based map mesh from image data
    fn c_LoadMaterials(fileName: const u8&, materialCount: i32&) -> u64 = "LoadMaterials"; // Load materials from model file
    fn LoadMaterialDefault() -> Material; // Load default material (Supports: DIFFUSE, SPECULAR, NORMAL maps)
    fn IsMaterialValid(material: Material) -> bool; // Check if material is valid (shader assigned, map textures loaded in GPU)
    fn UnloadMaterial(material: Material); // Unload material from GPU memory (VRAM)
    fn SetMaterialTexture(material: Material&, mapType: i32, texture: Texture2D); // Set texture for a material map type (MATERIAL_MAP_DIFFUSE, MATERIAL_MAP_SPECULAR...)
    fn SetModelMeshMaterial(model: Model&, meshId: i32, materialId: i32); // Set material for a mesh
    fn c_LoadModelAnimations(fileName: const u8&, animCount: i32&) -> u64 = "LoadModelAnimations"; // Load model animations from file
    fn UpdateModelAnimation(model: Model, anim: ModelAnimation, frame: f32); // Update model animation pose (vertex buffers and bone matrices)
    fn UpdateModelAnimationEx(model: Model, animA: ModelAnimation, frameA: f32, animB: ModelAnimation, frameB: f32, blend: f32); // Update model animation pose, blending two animations
    fn UnloadModelAnimations(animations: u64, animCount: i32); // Unload animation array data
    fn IsModelAnimationValid(model: Model, anim: ModelAnimation) -> bool; // Check model animation skeleton match
    fn CheckCollisionSpheres(center1: Vector3, radius1: f32, center2: Vector3, radius2: f32) -> bool; // Check collision between two spheres
    fn CheckCollisionBoxes(box1: BoundingBox, box2: BoundingBox) -> bool; // Check collision between two bounding boxes
    fn CheckCollisionBoxSphere(box: BoundingBox, center: Vector3, radius: f32) -> bool; // Check collision between box and sphere
    fn GetRayCollisionSphere(ray: Ray, center: Vector3, radius: f32) -> RayCollision; // Get collision info between ray and sphere
    fn GetRayCollisionBox(ray: Ray, box: BoundingBox) -> RayCollision; // Get collision info between ray and box
    fn GetRayCollisionMesh(ray: Ray, mesh: Mesh, transform: Matrix) -> RayCollision; // Get collision info between ray and mesh
    fn GetRayCollisionTriangle(ray: Ray, p1: Vector3, p2: Vector3, p3: Vector3) -> RayCollision; // Get collision info between ray and triangle
    fn GetRayCollisionQuad(ray: Ray, p1: Vector3, p2: Vector3, p3: Vector3, p4: Vector3) -> RayCollision; // Get collision info between ray and quad
    fn InitAudioDevice(); // Initialize audio device and context
    fn CloseAudioDevice(); // Close the audio device and context
    fn IsAudioDeviceReady() -> bool; // Check if audio device has been initialized successfully
    fn SetMasterVolume(volume: f32); // Set master volume (listener)
    fn GetMasterVolume() -> f32; // Get master volume (listener)
    fn c_LoadWave(fileName: const u8&) -> Wave = "LoadWave"; // Load wave data from file
    fn c_LoadWaveFromMemory(fileType: const u8&, fileData: const u8&, dataSize: i32) -> Wave = "LoadWaveFromMemory"; // Load wave from memory buffer, fileType refers to extension: i.e. '.wav'
    fn c_LoadWaveFromMemory_null_fileData(fileType: const u8&, fileData: u64, dataSize: i32) -> Wave = "LoadWaveFromMemory";
    fn IsWaveValid(wave: Wave) -> bool; // Check if wave data is valid (data loaded and parameters)
    fn c_LoadSound(fileName: const u8&) -> Sound = "LoadSound"; // Load sound from file
    fn LoadSoundFromWave(wave: Wave) -> Sound; // Load sound from wave data
    fn LoadSoundAlias(source: Sound) -> Sound; // Load sound alias, new sound that shares the same sample data as the source sound, does not own the sound data
    fn IsSoundValid(sound: Sound) -> bool; // Check if sound is valid (data loaded and buffers initialized)
    fn UpdateSound(sound: Sound, data: u64, frameCount: i32); // Update sound buffer with new data (default data format: 32 bit float, stereo)
    fn UnloadWave(wave: Wave); // Unload wave data
    fn UnloadSound(sound: Sound); // Unload sound
    fn UnloadSoundAlias(alias: Sound); // Unload sound alias (does not deallocate sample data)
    fn c_ExportWave(wave: Wave, fileName: const u8&) -> bool = "ExportWave"; // Export wave data to file, returns true on success
    fn c_ExportWaveAsCode(wave: Wave, fileName: const u8&) -> bool = "ExportWaveAsCode"; // Export wave sample data to code (.h), returns true on success
    fn PlaySound(sound: Sound); // Play a sound
    fn StopSound(sound: Sound); // Stop playing a sound
    fn PauseSound(sound: Sound); // Pause a sound
    fn ResumeSound(sound: Sound); // Resume a paused sound
    fn IsSoundPlaying(sound: Sound) -> bool; // Check if sound is currently playing
    fn SetSoundVolume(sound: Sound, volume: f32); // Set volume for a sound (1.0 is max level)
    fn SetSoundPitch(sound: Sound, pitch: f32); // Set pitch for a sound (1.0 is base level)
    fn SetSoundPan(sound: Sound, pan: f32); // Set pan for a sound (-1.0 left, 0.0 center, 1.0 right)
    fn WaveCopy(wave: Wave) -> Wave; // Copy a wave to a new wave
    fn WaveCrop(wave: Wave&, initFrame: i32, finalFrame: i32); // Crop a wave to defined frames range
    fn WaveFormat(wave: Wave&, sampleRate: i32, sampleSize: i32, channels: i32); // Convert wave data to desired format
    fn LoadWaveSamples(wave: Wave) -> u64; // Load samples data from wave as a 32bit float data array
    fn UnloadWaveSamples(samples: u64); // Unload samples data loaded with LoadWaveSamples()
    fn c_LoadMusicStream(fileName: const u8&) -> Music = "LoadMusicStream"; // Load music stream from file
    fn c_LoadMusicStreamFromMemory(fileType: const u8&, data: const u8&, dataSize: i32) -> Music = "LoadMusicStreamFromMemory"; // Load music stream from data
    fn c_LoadMusicStreamFromMemory_null_data(fileType: const u8&, data: u64, dataSize: i32) -> Music = "LoadMusicStreamFromMemory";
    fn IsMusicValid(music: Music) -> bool; // Check if music stream is valid (context and buffers initialized)
    fn UnloadMusicStream(music: Music); // Unload music stream
    fn PlayMusicStream(music: Music); // Start music playing
    fn IsMusicStreamPlaying(music: Music) -> bool; // Check if music is playing
    fn UpdateMusicStream(music: Music); // Update buffers for music streaming
    fn StopMusicStream(music: Music); // Stop music playing
    fn PauseMusicStream(music: Music); // Pause music playing
    fn ResumeMusicStream(music: Music); // Resume playing paused music
    fn SeekMusicStream(music: Music, position: f32); // Seek music to a position (in seconds)
    fn SetMusicVolume(music: Music, volume: f32); // Set volume for music (1.0 is max level)
    fn SetMusicPitch(music: Music, pitch: f32); // Set pitch for music (1.0 is base level)
    fn SetMusicPan(music: Music, pan: f32); // Set pan for music (-1.0 left, 0.0 center, 1.0 right)
    fn GetMusicTimeLength(music: Music) -> f32; // Get music time length (in seconds)
    fn GetMusicTimePlayed(music: Music) -> f32; // Get current music time played (in seconds)
    fn LoadAudioStream(sampleRate: u32, sampleSize: u32, channels: u32) -> AudioStream; // Load audio stream (to stream raw audio pcm data)
    fn IsAudioStreamValid(stream: AudioStream) -> bool; // Check if an audio stream is valid (buffers initialized)
    fn UnloadAudioStream(stream: AudioStream); // Unload audio stream and free memory
    fn UpdateAudioStream(stream: AudioStream, data: u64, frameCount: i32); // Update audio stream buffers with data
    fn IsAudioStreamProcessed(stream: AudioStream) -> bool; // Check if any audio stream buffers requires refill
    fn PlayAudioStream(stream: AudioStream); // Play audio stream
    fn PauseAudioStream(stream: AudioStream); // Pause audio stream
    fn ResumeAudioStream(stream: AudioStream); // Resume audio stream
    fn IsAudioStreamPlaying(stream: AudioStream) -> bool; // Check if audio stream is playing
    fn StopAudioStream(stream: AudioStream); // Stop audio stream
    fn SetAudioStreamVolume(stream: AudioStream, volume: f32); // Set volume for audio stream (1.0 is max level)
    fn SetAudioStreamPitch(stream: AudioStream, pitch: f32); // Set pitch for audio stream (1.0 is base level)
    fn SetAudioStreamPan(stream: AudioStream, pan: f32); // Set pan for audio stream (-1.0 left, 0.0 center, 1.0 right)
    fn SetAudioStreamBufferSizeDefault(size: i32); // Default size for new audio streams
}

